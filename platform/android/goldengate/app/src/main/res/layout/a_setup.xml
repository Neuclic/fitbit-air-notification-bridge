<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android 通知 → Fitbit Air"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="v10020：记录每次尝试的真实失败阶段；震动后释放 Bridge，并提供一键重开 Google Health 来刷新旧 Gattlink/DTLS 会话。" />

            <Button
                android:id="@+id/dncs_probe_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="打开 DNCS 排除性探针（已证实不震动）" />

            <TextView
                android:id="@+id/selected_device_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#EEEEEE"
                android:padding="10dp"
                android:text="目标设备：未选择 Fitbit Air"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/manual_test_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="测试 SINGLE（记录首次失败详情）" />

            <Button
                android:id="@+id/open_google_health_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="重开 Google Health 恢复同步" />

            <TextView
                android:id="@+id/last_task_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/black"
                android:padding="10dp"
                android:text="最近任务：尚未执行"
                android:textColor="@android:color/white"
                android:textIsSelectable="true"
                android:typeface="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="通知规则（最多 5 个）"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/notification_package_allowlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="com.tencent.mm=single"
                android:inputType="textMultiLine|textVisiblePassword"
                android:maxLines="5"
                android:minLines="3"
                android:singleLine="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="每行：应用包名=pattern。pattern 可选 single、double、triple、long_gap、urgent。" />

            <Button
                android:id="@+id/notification_access_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="保存规则并打开通知访问权限" />

            <TextView
                android:id="@+id/notification_access_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/black"
                android:padding="10dp"
                android:text="通知访问权限状态：未检查"
                android:textColor="@android:color/white"
                android:textIsSelectable="true"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="v10019 已证实 Link Controller 断链请求虽然返回完成，但 Air 没有发生真实物理断链（sawDisconnect=false）。普通 APK 无法直接销毁 Google Health 进程里的旧会话；v10020 的恢复动作会清空其现有 Activity task 并重新启动入口，但不会强行停止 Google Health 进程。" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/start_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:text="选择并保存 Fitbit Air"
        android:textColor="@android:color/white" />
</LinearLayout>
