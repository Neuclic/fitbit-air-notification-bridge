<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android 通知 → Fitbit Air"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="v10018：不扫描，按已保存地址尝试加入 Google Health 已维持的系统 GATT 链路，再建立独立 Gattlink/DTLS。请保持 Google Health 正常运行。" />

            <Button
                android:id="@+id/dncs_probe_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="打开 DNCS 排除性探针（已证实不震动）" />

            <TextView
                android:id="@+id/selected_device_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#EEEEEE"
                android:padding="10dp"
                android:text="目标设备：未选择 Fitbit Air"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/manual_test_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="直接加入已有链路并测试 single pattern" />

            <TextView
                android:id="@+id/last_task_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/black"
                android:padding="10dp"
                android:text="最近任务：尚未执行"
                android:textColor="@android:color/white"
                android:textIsSelectable="true"
                android:typeface="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="通知规则（最多 5 个）"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/notification_package_allowlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="com.tencent.mm=single"
                android:inputType="textMultiLine|textVisiblePassword"
                android:maxLines="5"
                android:minLines="3"
                android:singleLine="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="每行：应用包名=pattern。pattern 可选 single、double、triple、long_gap、urgent。" />

            <Button
                android:id="@+id/notification_access_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="保存规则并打开通知访问权限" />

            <TextView
                android:id="@+id/notification_access_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/black"
                android:padding="10dp"
                android:text="通知访问权限状态：未检查"
                android:textColor="@android:color/white"
                android:textIsSelectable="true"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="v10017 已证实重复 DNCS 服务无订阅且直发不震动。v10018 是已知地址双 GATT-client 共存实验；成功后还要确认 Google Health 仍保持连接。" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/start_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:text="选择并保存 Fitbit Air"
        android:textColor="@android:color/white" />
</LinearLayout>
